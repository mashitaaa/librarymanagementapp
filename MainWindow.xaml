<Window x:Class="LibraryManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Management"
        Height="680"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="INPUT BUKU"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Kode Buku"/>
            <TextBox x:Name="txtKode"
                     Height="32"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Judul Buku"/>
            <TextBox x:Name="txtJudul"
                     Height="32"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Pengarang"/>
            <TextBox x:Name="txtPengarang"
                     Height="32"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Kategori"/>
            <ComboBox x:Name="cmbKategori"
                      Height="32"
                      Margin="0,5,0,12">
                <ComboBoxItem Content="Fiksi"/>
                <ComboBoxItem Content="Non-Fiksi"/>
                <ComboBoxItem Content="Sains dan Teknologi"/>
                <ComboBoxItem Content="Pendidikan"/>
                <ComboBoxItem Content="Referensi"/>
            </ComboBox>

            <TextBlock Text="Tanggal Masuk"/>
            <DatePicker x:Name="dpTanggal"
                        Height="32"
                        Margin="0,5,0,12"/>

            <TextBlock Text="Status"/>
            <StackPanel Orientation="Horizontal"
                        Margin="0,5,0,20">
                <RadioButton x:Name="rbTersedia"
                             Content="Tersedia"
                             Margin="0,0,20,0"/>
                <RadioButton x:Name="rbDipinjam"
                             Content="Dipinjam"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Tambah"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="BtnTambah_Click"/>
                <Button Content="Reset"
                        Width="120"
                        Height="40"
                        Click="BtnReset_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="DATA BUKU"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Cari (kode, judul, atau pengarang)"/>
            <TextBox x:Name="txtCari"
                     Height="32"
                     Margin="0,5,0,12"
                     TextChanged="TxtCari_TextChanged"/>

            <DataGrid x:Name="dgBuku"
                      Height="340"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="70"/>
                    <DataGridTextColumn Header="Judul" Binding="{Binding Judul}" Width="*"/>
                    <DataGridTextColumn Header="Pengarang" Binding="{Binding Pengarang}" Width="120"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Tgl Masuk" Binding="{Binding TanggalMasuk, StringFormat=dd/MM/yyyy}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="txtJumlah"
                       Text="Jumlah Buku: 0"
                       Margin="0,10,0,0"/>

            <Button Content="Hapus"
                    Width="120"
                    Height="40"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Click="BtnHapus_Click"/>
        </StackPanel>
    </Grid>
</Window>
